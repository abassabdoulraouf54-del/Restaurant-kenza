import { usePageMeta } from '@/hooks/usePageMeta'
import { useMemo } from 'react'
import { Link } from 'react-router-dom'
import { Minus, Plus, ShoppingBag, Trash2, TriangleAlert } from 'lucide-react'
import { useCatalog } from '@/hooks/useCatalog'
import { useCart } from '@/hooks/useCart'
import { formatXOF } from '@/utils/format'

export default function Cart() {
  usePageMeta("Panier | Restaurant Kenza", undefined, true)
  const { products, loading, error, retry } = useCatalog()
  const { lines, count, setQuantity, remove, clear } = useCart()

  const rows = useMemo(() => {
    const byId = new Map(products.map((p) => [p.id, p] as const))
    return lines.map((l) => {
      const product = byId.get(l.productId)
      const valid = !!product && product.is_available
      return { line: l, product, valid, subtotal: valid ? product.price_xof * l.quantity : 0 }
    })
  }, [lines, products])

  const total = rows.reduce((sum, r) => sum + r.subtotal, 0)
  const hasInvalid = rows.some((r) => !r.valid)

  if (lines.length === 0) {
    return (
      <section className="mx-auto max-w-3xl px-4 py-24 text-center">
        <ShoppingBag size={48} className="mx-auto text-kenza-orange" />
        <h1 className="mt-4 font-display text-3xl font-bold">Votre panier est vide</h1>
        <p className="mt-2 text-kenza-black/70">Découvrez nos pintades frites, brochettes et boissons.</p>
        <Link to="/menu" className="mt-8 inline-block rounded-full bg-kenza-orange px-8 py-3 font-semibold text-white hover:bg-kenza-orange-dark">
          Voir le menu
        </Link>
      </section>
    )
  }

  return (
    <section className="mx-auto max-w-4xl px-4 py-12">
      <div className="flex items-end justify-between">
        <h1 className="font-display text-4xl font-bold">Votre panier</h1>
        <button type="button" onClick={clear} className="text-sm text-kenza-black/60 underline hover:text-kenza-orange">
          Vider le panier
        </button>
      </div>
      <p className="mt-1 text-sm text-kenza-black/60">
        {count} article{count > 1 ? 's' : ''}
      </p>

      {loading && <p className="mt-8 text-kenza-black/70">Chargement des prix…</p>}

      {error && (
        <div className="mt-8 rounded-2xl border border-red-200 bg-red-50 p-6 text-red-800">
          {error}{' '}
          <button type="button" onClick={retry} className="font-semibold underline">
            Réessayer
          </button>
        </div>
      )}

      {!loading && !error && (
        <>
          {hasInvalid && (
            <div className="mt-6 flex gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
              <TriangleAlert size={20} className="shrink-0" />
              <p>
                Certains produits ne sont plus disponibles. Retirez-les de votre panier pour continuer.
              </p>
            </div>
          )}

          <ul className="mt-6 divide-y divide-kenza-gold/30 rounded-2xl border border-kenza-gold/30 bg-white">
            {rows.map(({ line, product, valid, subtotal }) => (
              <li key={line.productId} className="flex flex-wrap items-center gap-4 p-4 sm:p-5">
                <div className="min-w-0 flex-1">
                  <p className="font-display text-lg font-semibold">{product?.name ?? 'Produit introuvable'}</p>
                  {product && valid ? (
                    <p className="text-sm text-kenza-black/60">{formatXOF(product.price_xof)} l’unité</p>
                  ) : (
                    <p className="text-sm font-medium text-red-700">Indisponible</p>
                  )}
                </div>

                {product && valid && (
                  <div className="flex items-center gap-2" role="group" aria-label={`Quantité de ${product.name}`}>
                    <button
                      type="button"
                      onClick={() => setQuantity(line.productId, line.quantity - 1)}
                      aria-label="Diminuer la quantité"
                      className="rounded-full border border-kenza-gold/50 p-2 hover:border-kenza-orange hover:text-kenza-orange"
                    >
                      <Minus size={16} />
                    </button>
                    <span className="w-8 text-center font-semibold" aria-live="polite">
                      {line.quantity}
                    </span>
                    <button
                      type="button"
                      onClick={() => setQuantity(line.productId, line.quantity + 1)}
                      aria-label="Augmenter la quantité"
                      className="rounded-full border border-kenza-gold/50 p-2 hover:border-kenza-orange hover:text-kenza-orange"
                    >
                      <Plus size={16} />
                    </button>
                  </div>
                )}

                <p className="w-28 text-right font-bold">{valid ? formatXOF(subtotal) : '—'}</p>

                <button
                  type="button"
                  onClick={() => remove(line.productId)}
                  aria-label={`Retirer ${product?.name ?? 'ce produit'} du panier`}
                  className="rounded-full p-2 text-kenza-black/50 hover:bg-red-50 hover:text-red-600"
                >
                  <Trash2 size={18} />
                </button>
              </li>
            ))}
          </ul>

          <div className="mt-8 rounded-2xl bg-kenza-black p-6 text-kenza-cream">
            <div className="flex items-center justify-between text-lg">
              <span>Sous-total</span>
              <span className="font-bold text-kenza-gold">{formatXOF(total)}</span>
            </div>
            <p className="mt-2 text-sm text-kenza-cream/60">
              Les frais de livraison éventuels seront ajoutés à l’étape suivante. Prix provisoires, à confirmer par
              le restaurant.
            </p>
            <div className="mt-6 flex flex-wrap gap-3">
              <Link
                to="/menu"
                className="rounded-full border border-kenza-gold/60 px-6 py-3 font-semibold text-kenza-gold hover:bg-kenza-gold hover:text-kenza-black"
              >
                Continuer mes achats
              </Link>
              {hasInvalid || total === 0 ? (
                <button
                  type="button"
                  disabled
                  className="cursor-not-allowed rounded-full bg-kenza-orange/40 px-8 py-3 font-semibold text-white/70"
                >
                  Valider ma commande
                </button>
              ) : (
                <Link
                  to="/commander"
                  className="rounded-full bg-kenza-orange px-8 py-3 font-semibold text-white hover:bg-kenza-orange-dark"
                >
                  Valider ma commande
                </Link>
              )}
            </div>
          </div>
        </>
      )}
    </section>
  )
}
